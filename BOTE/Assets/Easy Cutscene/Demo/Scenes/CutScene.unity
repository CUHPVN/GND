      value: "\u0110\xE3 t\u1EEBng c\xF3 m\u1ED9t th\u1EDDi... khi kh\u1EAFp th\u1EBF
        gian \u0111\u01B0\u1EE3c ph\u1EE7 \u0111\u1EA7y b\u1EDFi nh\u1EEFng c\xE1nh
        \u0111\u1ED3ng hoa m\xE0u. "
      objectReference: {fileID: 0}
    - target: {fileID: 6574975663053359403, guid: 6056f01e95dfba646bc4cc2b3ad70de0, type: 3}
      propertyPath: cutsceneData.Array.data[0].nameString
      value: 
      objectReference: {fileID: 0}
    - target: {fileID: 6574975663053359403, guid: 6056f01e95dfba646bc4cc2b3ad70de0, type: 3}
      propertyPath: cutsceneData.Array.data[1].chatString
      value: "N\u01A1i con ng\u01B0\u1EDDi v\xE0 thi\xEAn nhi\xEAn c\xF9ng nhau chung
        s\u1ED1ng. "
      objectReference: {fileID: 0}
    - target: {fileID: 6574975663053359403, guid: 6056f01e95dfba646bc4cc2b3ad70de0, type: 3}
      propertyPath: cutsceneData.Array.data[1].nameString
      value: 
      objectReference: {fileID: 0}
    - target: {fileID: 6574975663053359403, guid: 6056f01e95dfba646bc4cc2b3ad70de0, type: 3}
      propertyPath: cutsceneData.Array.data[2].chatString
      value: "Kh\xF4ng s\u1EE3 h\xE3i!"
      objectReference: {fileID: 0}
    - target: {fileID: 6574975663053359403, guid: 6056f01e95dfba646bc4cc2b3ad70de0, type: 3}
      propertyPath: cutsceneData.Array.data[2].nameString
      value: 
      objectReference: {fileID: 0}
    - target: {fileID: 6574975663053359403, guid: 6056f01e95dfba646bc4cc2b3ad70de0, type: 3}
      propertyPath: cutsceneData.Array.data[3].chatString
      value: "Kh\xF4ng nghi ng\u1EDD"
      objectReference: {fileID: 0}
    - target: {fileID: 6574975663053359403, guid: 6056f01e95dfba646bc4cc2b3ad70de0, type: 3}
      propertyPath: cutsceneData.Array.data[3].nameString
      value: 
      objectReference: {fileID: 0}
    - target: {fileID: 6574975663053359403, guid: 6056f01e95dfba646bc4cc2b3ad70de0, type: 3}
      propertyPath: cutsceneData.Array.data[4].chatString
      value: "Nh\u01B0ng l\xF2ng tham c\u1EE7a con ng\u01B0\u1EDDi \u0111\xE3 che
        m\u1EDD \u0111i t\u1EA5t c\u1EA3"
      objectReference: {fileID: 0}
    - target: {fileID: 6574975663053359403, guid: 6056f01e95dfba646bc4cc2b3ad70de0, type: 3}
      propertyPath: cutsceneData.Array.data[5].chatString
      value: "Ch\xFAng ta quay l\u01B0ng, ch\u1ED1i b\u1ECF ti\u1EBFng g\u1ECDi c\u1EE7a
        \u0111\u1EA5t m\u1EB9, \u0111\u1EC3 r\u1ED3i t\u1EF1 tay vi\u1EBFt n\xEAn
        b\u1EA3n \xE1n t\xE0n kh\u1ED1c cho ch\xEDnh m\xECnh"
      objectReference: {fileID: 0}
    - target: {fileID: 6574975663053359403, guid: 6056f01e95dfba646bc4cc2b3ad70de0, type: 3}
      propertyPath: cutsceneData.Array.data[6].chatString
      value: "Gi\u1EDD \u0111\xE2y, th\u1EBF gi\u1EDBi r\u1EA1n n\u1EE9t th\xE0nh
        hai n\u1EEDa"
      objectReference: {fileID: 0}
    - target: {fileID: 6574975663053359403, guid: 6056f01e95dfba646bc4cc2b3ad70de0, type: 3}
      propertyPath: cutsceneData.Array.data[7].chatString
      value: "Tr\xEAn T\u1EA7ng Cao \u2013 th\xE1nh \u0111\u1ECBa c\u1EE7a quy\u1EC1n
        l\u1EF1c"
      objectReference: {fileID: 0}
    - target: {fileID: 6574975663053359403, guid: 6056f01e95dfba646bc4cc2b3ad70de0, type: 3}
      propertyPath: cutsceneData.Array.data[8].chatString
      value: "N\u01A1i \u0111\u1EB7c \xE2n l\u1EDBn nh\u1EA5t c\u1EE7a m\u1ED9t con
        ng\u01B0\u1EDDi ch\u1EC9 \u0111\u01A1n gi\u1EA3n l\xE0 \u0111\u01B0\u1EE3c
        h\xEDt th\u1EDF... "
      objectReference: {fileID: 0}
    - target: {fileID: 6574975663053359403, guid: 6056f01e95dfba646bc4cc2b3ad70de0, type: 3}
      propertyPath: cutsceneData.Array.data[9].chatString
      value: "H\xEDt th\u1EDF th\u1EE9 kh\xF4ng kh\xED trong l\xE0nh \u0111\xE1ng
        l\u1EBD ra ph\u1EA3i thu\u1ED9c v\u1EC1 t\u1EA5t c\u1EA3."
      objectReference: {fileID: 0}
    - target: {fileID: 6574975663053359403, guid: 6056f01e95dfba646bc4cc2b3ad70de0, type: 3}
      propertyPath: cutsceneData.Array.data[10].chatString
      value: "V\xE0 d\u01B0\u1EDBi T\u1EA7ng Th\u1EA5p\u2026 l\xE0 V\xF9ng \u0110\u1EA5t
        Tro T\xE0n"
      objectReference: {fileID: 0}
    - target: {fileID: 6574975663053359403, guid: 6056f01e95dfba646bc4cc2b3ad70de0, type: 3}
      propertyPath: cutsceneData.Array.data[11].chatString
      value: "N\u01A1i \xE1nh m\u1EB7t tr\u1EDDi ch\u1EC9 c\xF2n l\xE0 nh\u1EEFng
        tia s\xE1ng thoi th\xF3p, len l\u1ECFi qua m\xE0n s\u01B0\u01A1ng \u0111\u1ED9c
        h\u1EA1i, \u0111\u1EB7c qu\xE1nh"
      objectReference: {fileID: 0}
    - target: {fileID: 6574975663053359403, guid: 6056f01e95dfba646bc4cc2b3ad70de0, type: 3}
      propertyPath: cutsceneData.Array.data[12].chatString
      value: "N\u01A1i nh\u1EEFng k\u1EBB b\u1ECB ru\u1ED3ng b\u1ECF ph\u1EA3i g\u1ED3ng
        m\xECnh g\xE1nh ch\u1ECBu c\u01A1n th\u1ECBnh n\u1ED9 c\u1EE7a t\u1EF1 nhi\xEAn."
      objectReference: {fileID: 0}
    - target: {fileID: 6574975663053359403, guid: 6056f01e95dfba646bc4cc2b3ad70de0, type: 3}
      propertyPath: cutsceneData.Array.data[13].chatString
      value: "Nh\u01B0ng \u1EDF n\u01A1i \u0111\xE1y s\xE2u tuy\u1EC7t v\u1ECDng
        \u1EA5y\u2026 v\u1EABn c\xF2n m\u1ED9t ng\u01B0\u1EDDi cha"
      objectReference: {fileID: 0}
    - target: {fileID: 6574975663053359403, guid: 6056f01e95dfba646bc4cc2b3ad70de0, type: 3}
      propertyPath: cutsceneData.Array.data[14].chatString
      value: "M\u1ED9t k\u1EBB \u0111ang ngoan c\u1ED1 ch\u1ED1ng l\u1EA1i c\u1EA3
        s\u1ED1 m\u1EC7nh, ch\u1EAFt chiu t\u1EEBng nh\u1ECBp th\u1EDF thoi th\xF3p
        cho m\u1EA3nh \u0111\u1EA5t kh\xF4 c\u1EB1n n\xE0y."
      objectReference: {fileID: 0}
    - target: {fileID: 6574975663053359403, guid: 6056f01e95dfba646bc4cc2b3ad70de0, type: 3}
      propertyPath: cutsceneData.Array.data[15].chatString
      value: "V\xE0 cho \u0111\u1EE9a con g\xE1i b\xE9 b\u1ECFng c\u1EE7a m\xECnh!"
      objectReference: {fileID: 0}
    - target: {fileID: 6574975663053359403, guid: 6056f01e95dfba646bc4cc2b3ad70de0, type: 3}
      propertyPath: cutsceneData.Array.data[16].chatString
      value: "Gi\u1EDD \u0111\xE2y, th\u1EBF gi\u1EDBi r\u1EA1n n\u1EE9t th\xE0nh
        hai n\u1EEDa"
      objectReference: {fileID: 0}
