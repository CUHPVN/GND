--- !u!114 &1643682971
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1643682969}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e3c4a232f1b87b04ba7fa5d4567b9b8a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  cutsceneData:
  - name: 
    charactersData: []
    propsData: []
    nameString: 
    chatString: "S\u1EF1 tr\u1EA3 th\xF9 c\u1EE7a thi\xEAn nhi\xEAn ch\u01B0a bao
      gi\u1EDD bu\xF4ng tha ch\xFAng t\xF4i.... C\u01A1n ho c\u1EE7a con b\xE9 ng\xE0y
      m\u1ED9t n\u1EB7ng h\u01A1n"
    cutscenePreEvent:
      m_PersistentCalls:
        m_Calls: []
    cutscenePostEvent:
      m_PersistentCalls:
        m_Calls: []
    autoNext: 1
  - name: 
    charactersData: []
    propsData: []
    nameString: 
    chatString: "L\xE3o th\u01B0\u01A1ng nh\xE2n \u1EDF khu ch\u1EE3 \u0111en c\xF3
      th\u1EE9 thu\u1ED1c xoa d\u1ECBu \u0111\u01B0\u1EE3c c\u01A1n \u0111au n\xE0y,
      nh\u01B0ng d\u01B0\u1EDBi \u0111\xE1y T\u1EA7ng Th\u1EA5p, ch\u1EB3ng c\xF3
      \u0111\u1EB7c \xE2n n\xE0o l\xE0 mi\u1EC5n ph\xED"
    cutscenePreEvent:
      m_PersistentCalls:
        m_Calls: []
    cutscenePostEvent:
      m_PersistentCalls:
        m_Calls: []
    autoNext: 1
  - name: 
    charactersData: []
    propsData: []
    nameString: 
    chatString: "H\u1EAFn ta c\u1EA7n ti\u1EC1n, r\u1EA5t nhi\u1EC1u ti\u1EC1n."
    cutscenePreEvent:
      m_PersistentCalls:
        m_Calls: []
    cutscenePostEvent:
      m_PersistentCalls:
        m_Calls: []
    autoNext: 1
  - name: 
    charactersData: []
    propsData: []
    nameString: 
    chatString: "The Ashland... n\u01A1i n\xE0y t\u1EEBng l\xE0 m\u1ED9t thung l\u0169ng
      n\xF4ng nghi\u1EC7p tr\xF9 ph\xFA, tr\u01B0\u1EDBc khi l\xF2ng tham bi\u1EBFn
      n\xF3 th\xE0nh V\xF9ng \u0110\u1EA5t Tro T\xE0n."
    cutscenePreEvent:
      m_PersistentCalls:
        m_Calls: []
    cutscenePostEvent:
      m_PersistentCalls:
        m_Calls: []
    autoNext: 1
  - name: 
    charactersData: []
    propsData: []
    nameString: 
    chatString: "Gi\u1EDD \u0111\xE2y ch\u1EC9 c\xF2n l\u1EA1i nh\u1EEFng m\u1EA3nh
      \u0111\u1EA5t v\u1EE5n v\u1EB1n, ng\u1EAFc ngo\u1EA3i d\u01B0\u1EDBi l\xE0n
      s\u01B0\u01A1ng \u0111\u1ED9c h\u1EA1i"
    cutscenePreEvent:
      m_PersistentCalls:
        m_Calls: []
    cutscenePostEvent:
      m_PersistentCalls:
        m_Calls: []
    autoNext: 1
  - name: 
    charactersData: []
    propsData: []
    nameString: 
    chatString: "Nh\u01B0ng \u0111\u1EC3 gi\u1EEF l\u1EA1i h\u01A1i th\u1EDF cho
      con b\xE9, t\xF4i ph\u1EA3i \u0111\xE1nh th\u1EE9c m\u1EA3nh \u0111\u1EA5t
      n\xE0y m\u1ED9t l\u1EA7n n\u1EEFa. "
    cutscenePreEvent:
      m_PersistentCalls:
        m_Calls: []
    cutscenePostEvent:
      m_PersistentCalls:
        m_Calls: []
    autoNext: 1
  - name: 
    charactersData: []
    propsData: []
    nameString: 
    chatString: "Ph\u1EA3i cu\u1ED1c tung l\u1EDBp v\u1ECF ch\u1EBFt ch\xF3c n\xE0y
      l\xEAn."
    cutscenePreEvent:
      m_PersistentCalls:
        m_Calls: []
    cutscenePostEvent:
      m_PersistentCalls:
        m_Calls: []
    autoNext: 1
  - name: 
    charactersData: []
    propsData: []
    nameString: 
    chatString: "Gieo xu\u1ED1ng nh\u1EEFng h\u1EA1t m\u1EA7m thoi th\xF3p"
    cutscenePreEvent:
      m_PersistentCalls:
        m_Calls: []
    cutscenePostEvent:
      m_PersistentCalls:
        m_Calls: []
    autoNext: 1
  - name: 
    charactersData: []
    propsData: []
    nameString: 
    chatString: "T\u01B0\u1EDBi l\xEAn nh\u1EEFng gi\u1ECDt n\u01B0\u1EDBc \u0111\u1EE5c
      ng\u1EA7u v\xE0 ..."
    cutscenePreEvent:
      m_PersistentCalls:
        m_Calls: []
    cutscenePostEvent:
      m_PersistentCalls:
        m_Calls: []
    autoNext: 1
  - name: 
    charactersData: []
    propsData: []
    nameString: 
    chatString: "Hi v\u1ECDng s\u01B0\u01A1ng m\xF9 ng\xE0y mai s\u1EBD nh\xE2n t\u1EEB
      h\u01A1n \u0111\u1EC3 m\u1EA7m s\u1ED1ng k\u1ECBp v\u01B0\u01A1n l\xEAn."
    cutscenePreEvent:
      m_PersistentCalls:
        m_Calls: []
    cutscenePostEvent:
      m_PersistentCalls:
        m_Calls: []
    autoNext: 0
  currentID: 2
  charaNameText: {fileID: 1460095018}
  chatText: {fileID: 1460095017}
