    autoNext: 1
  - name: 
    charactersData: []
    propsData: []
    nameString: 
    chatString: "H\u1EAFn ta c\u1EA7n ti\u1EC1n, r\u1EA5t nhi\u1EC1u ti\u1EC1n."
    cutscenePreEvent:
      m_PersistentCalls:
        m_Calls: []
    cutscenePostEvent:
      m_PersistentCalls:
        m_Calls: []
    autoNext: 1
  - name: 
    charactersData: []
    propsData: []
    nameString: 
    chatString: "\u0110\u1EC3 gi\u1EEF l\u1EA1i h\u01A1i th\u1EDF cho con b\xE9,
      t\xF4i ph\u1EA3i \u0111\xE1nh th\u1EE9c m\u1EA3nh \u0111\u1EA5t n\xE0y m\u1ED9t
