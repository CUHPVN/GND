--- !u!114 &5218599089645927033
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4785791807812878700}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e3c4a232f1b87b04ba7fa5d4567b9b8a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  cutsceneData:
  - name: 
    charactersData:
    - name: Silas
      initialTransformID: UILeft
      finalTransformID: UILeft
      spriteString: Silas-Idle
    - name: Shadow Broker
      initialTransformID: right
      finalTransformID: UIRight
      spriteString: TSB
    propsData: []
    nameString: Shadow Broker
    chatString: "Silas... Anh nh\xECn m\u1EA3nh \u0111\u1EA5t n\xE0y xem. N\xF3 \u0111ang
      ki\u1EC7t s\u1EE9c."
    cutscenePreEvent:
      m_PersistentCalls:
        m_Calls: []
    cutscenePostEvent:
      m_PersistentCalls:
        m_Calls: []
    autoNext: 1
  - name: 
    charactersData:
    - name: Shadow Broker
      initialTransformID: 
      finalTransformID: 
      spriteString: TSB
    - name: Silas
      initialTransformID: 
      finalTransformID: 
      spriteString: Silas-Idle
    propsData: []
    nameString: Shadow Broker
    chatString: "Anh v\u1EAFt ki\u1EC7t m\u1ED3 h\xF4i ch\u1EC9 \u0111\u1EC3 \u0111\u1ED5i
      l\u1EA5y v\xE0i \u0111\u1ED3ng b\u1EA1c l\u1EBB t\u1EEB l\xE3o Barnaby. Anh
      \u0111\u1ECBnh nu\xF4i con b\xE9 Elara b\u1EB1ng l\xF2ng t\u1EF1 tr\u1ECDng
      hay b\u1EB1ng thu\u1ED1c men?"
    cutscenePreEvent:
      m_PersistentCalls:
        m_Calls: []
    cutscenePostEvent:
      m_PersistentCalls:
        m_Calls: []
    autoNext: 1
  - name: 
    charactersData:
    - name: Shadow Broker
      initialTransformID: 
      finalTransformID: 
      spriteString: TSB
    - name: Silas
      initialTransformID: 
      finalTransformID: 
      spriteString: Silas-Idle
    propsData: []
    nameString: Silas
    chatString: "L\xE3o Barnaby tr\u1EA3 gi\xE1 c\xF4ng b\u1EB1ng cho nh\u1EEFng
      g\xEC s\u1EA1ch s\u1EBD. \u0110\u1EA5t nh\xE0 tao kh\xF4ng nu\xF4i nh\u1EEFng
      th\u1EE9 qu\xE1i thai m\xE0 m\xE0y mang \u0111\u1EBFn.\r"
    cutscenePreEvent:
      m_PersistentCalls:
        m_Calls: []
    cutscenePostEvent:
      m_PersistentCalls:
        m_Calls: []
    autoNext: 1
  - name: 
    charactersData:
    - name: Shadow Broker
      initialTransformID: 
      finalTransformID: 
      spriteString: TSB
    - name: Silas
      initialTransformID: 
      finalTransformID: 
      spriteString: Silas-Idle
    propsData: []
    nameString: Shadow Broker
    chatString: "\"Qu\xE1i thai\"???"
    cutscenePreEvent:
      m_PersistentCalls:
        m_Calls: []
    cutscenePostEvent:
      m_PersistentCalls:
        m_Calls: []
    autoNext: 1
  - name: 
    charactersData:
    - name: Shadow Broker
      initialTransformID: 
      finalTransformID: 
      spriteString: TSB
    - name: Silas
      initialTransformID: 
      finalTransformID: 
      spriteString: Silas-Idle
    propsData: []
    nameString: Shadow Broker
    chatString: "T\xF4i g\u1ECDi \u0111\xF3 l\xE0 S\u1EF1 Ti\u1EBFn H\xF3a"
    cutscenePreEvent:
      m_PersistentCalls:
        m_Calls: []
    cutscenePostEvent:
      m_PersistentCalls:
        m_Calls: []
    autoNext: 1
  - name: 
    charactersData:
    - name: Shadow Broker
      initialTransformID: 
      finalTransformID: 
      spriteString: TSB
    - name: Silas
      initialTransformID: 
      finalTransformID: 
      spriteString: Silas-Idle
    propsData: []
    nameString: Shadow Broker
    chatString: " Nh\u1EEFng h\u1EA1t gi\u1ED1ng \"T\xEDm\" n\xE0y kh\xF4ng c\u1EA7n
      m\u1EB7t tr\u1EDDi, kh\xF4ng c\u1EA7n n\u01B0\u1EDBc s\u1EA1ch. Ch\xFAng \u0103n
      s\u01B0\u01A1ng \u0111\u1ED9c \u0111\u1EC3 l\u1EDBn. Anh ch\u1EC9 c\u1EA7n
      gieo ch\xFAng xu\u1ED1ng, v\xE0 s\xE1ng mai, anh s\u1EBD c\xF3 \u0111\u1EE7
      ti\u1EC1n \u0111\u1EC3 mua thu\u1ED1c cho con g\xE1i. "
    cutscenePreEvent:
      m_PersistentCalls:
        m_Calls: []
    cutscenePostEvent:
      m_PersistentCalls:
        m_Calls: []
    autoNext: 1
  - name: 
    charactersData:
    - name: Shadow Broker
      initialTransformID: 
      finalTransformID: 
      spriteString: TSB
    - name: Silas
      initialTransformID: 
      finalTransformID: 
      spriteString: Silas-Angry
    propsData: []
    nameString: Silas
    chatString: "V\xE0 sau \u0111\xF3 th\xEC sao? Nh\u1EEFng v\u1EC7t \u0111en s\u1EBD
      loang ra. \u0110\u1EA5t s\u1EBD \u0111\xF4ng c\u1EE9ng l\u1EA1i nh\u01B0 th\u1EA1ch
      t\xEDn."
    cutscenePreEvent:
      m_PersistentCalls:
        m_Calls: []
    cutscenePostEvent:
      m_PersistentCalls:
        m_Calls: []
    autoNext: 1
  - name: 
    charactersData:
    - name: Shadow Broker
      initialTransformID: 
      finalTransformID: 
      spriteString: TSB
    - name: Silas
      initialTransformID: 
      finalTransformID: 
      spriteString: Silas-Angry
    propsData: []
    nameString: Silas
    chatString: "Tao l\xE0 n\xF4ng d\xE2n, tao bi\u1EBFt r\xF5 \u0111\u1EA5t \u0111ai
      c\u1EE7a tao. N\u1EBFu tao s\u1EED d\u1EE5ng  th\u1EE9 h\xF3a ch\u1EA5t \u0111\xF3,
      n\xF3 s\u1EBD kh\xF4ng bao gi\u1EDD c\xF3 th\u1EC3 ph\u1EE5c h\u1ED3i l\u1EA1i.\r\n"
    cutscenePreEvent:
      m_PersistentCalls:
        m_Calls: []
    cutscenePostEvent:
      m_PersistentCalls:
        m_Calls: []
    autoNext: 1
  - name: 
    charactersData:
    - name: Shadow Broker
      initialTransformID: 
      finalTransformID: 
      spriteString: TSB
    - name: Silas
      initialTransformID: 
      finalTransformID: 
      spriteString: Silas-Angry
    propsData: []
    nameString: Shadow Broker
    chatString: "\u0110\u1EA5t kh\xF4ng bi\u1EBFt tha th\u1EE9, anh Silas \xE0. N\xF3
      ch\u1EC9 l\xE0 c\xF4ng c\u1EE5."
    cutscenePreEvent:
      m_PersistentCalls:
        m_Calls: []
    cutscenePostEvent:
      m_PersistentCalls:
        m_Calls: []
    autoNext: 1
  - name: 
    charactersData:
    - name: Shadow Broker
      initialTransformID: 
      finalTransformID: 
      spriteString: TSB
    - name: Silas
      initialTransformID: 
      finalTransformID: 
      spriteString: Silas-Angry
    propsData: []
    nameString: Shadow Broker
    chatString: "Anh \u0111ang ch\u1ECDn m\u1ED9t \u0111\xE1m c\u1ECF d\u1EA1i thay
      v\xEC con g\xE1i m\xECnh sao?"
    cutscenePreEvent:
      m_PersistentCalls:
        m_Calls: []
    cutscenePostEvent:
      m_PersistentCalls:
        m_Calls: []
    autoNext: 1
  - name: 
    charactersData:
    - name: Shadow Broker
      initialTransformID: 
      finalTransformID: 
      spriteString: TSB
    - name: Silas
      initialTransformID: 
      finalTransformID: 
      spriteString: Silas-Angry
