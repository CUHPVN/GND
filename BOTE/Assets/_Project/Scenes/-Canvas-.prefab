            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 1
          m_CallState: 2
    autoNext: 1
  - name: 
    charactersData: []
    propsData: []
    nameString: 
    chatString: "H\u1EAFn ta c\u1EA7n ti\u1EC1n, r\u1EA5t nhi\u1EC1u ti\u1EC1n."
    cutscenePreEvent:
      m_PersistentCalls:
        m_Calls: []
    cutscenePostEvent:
      m_PersistentCalls:
        m_Calls: []
    autoNext: 1
  - name: 
    charactersData: []
    propsData: []
    nameString: 
    chatString: "\u0110\u1EC3 gi\u1EEF l\u1EA1i h\u01A1i th\u1EDF cho con b\xE9,
      t\xF4i ph\u1EA3i \u0111\xE1nh th\u1EE9c m\u1EA3nh \u0111\u1EA5t n\xE0y m\u1ED9t
      l\u1EA7n n\u1EEFa. "
    cutscenePreEvent:
      m_PersistentCalls:
        m_Calls: []
    cutscenePostEvent:
      m_PersistentCalls:
        m_Calls: []
    autoNext: 1
  - name: 
    charactersData: []
    propsData: []
    nameString: 
    chatString: "Ph\u1EA3i cu\u1ED1c tung l\u1EDBp v\u1ECF ch\u1EBFt ch\xF3c n\xE0y
      l\xEAn."
    cutscenePreEvent:
      m_PersistentCalls:
        m_Calls: []
