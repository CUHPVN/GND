    - name: Silas
      initialTransformID: 
      finalTransformID: 
      spriteString: Silas-Angry
    propsData: []
    nameString: Silas
    chatString: "\u0110\u1EEBng nh\u1EAFc \u0111\u1EBFn con g\xE1i tao b\u1EB1ng
      c\xE1i gi\u1ECDng \u0111\xF3!"
    cutscenePreEvent:
      m_PersistentCalls:
        m_Calls: []
    cutscenePostEvent:
      m_PersistentCalls:
        m_Calls: []
    autoNext: 1
