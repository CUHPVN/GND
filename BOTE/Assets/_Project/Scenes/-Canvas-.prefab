--- !u!114 &4007516477770831457
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6153034680473703104}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e3c4a232f1b87b04ba7fa5d4567b9b8a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  cutsceneData:
  - name: 
    charactersData: []
    propsData: []
    nameString: 
    chatString: "Nh\u1EEFng m\u1EA7m c\xE2y \u0111\xE3 l\u1EDBn h\u01A1n, kh\xF4ng
      nhi\u1EC1u nh\u01B0ng \u0111\u1EE7 \u0111\u1EC3 ch\u1EE9ng minh ch\xFAng v\u1EABn
      \u0111ang s\u1ED1ng."
    cutscenePreEvent:
      m_PersistentCalls:
        m_Calls: []
    cutscenePostEvent:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 5630476405160942549}
          m_TargetAssemblyTypeName: UnityEngine.GameObject, UnityEngine
          m_MethodName: SetActive
          m_Mode: 6
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
        - m_Target: {fileID: 3801244044233279608}
          m_TargetAssemblyTypeName: UnityEngine.GameObject, UnityEngine
          m_MethodName: SetActive
          m_Mode: 6
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 1
          m_CallState: 2
    autoNext: 1
  - name: 
    charactersData: []
    propsData: []
    nameString: 
    chatString: "Ta \u0111\xE3 mang ch\xFAng \u0111\u1EBFn ch\u1ED7 Barnaby, \xF4ng
      l\xE3o ch\u1EC9 nh\xECn m\u1ED9t l\xFAc r\u1ED3i g\u1EADt \u0111\u1EA7u: \u201CC\xF2n
      s\u1EA1ch.\u201D"
    cutscenePreEvent:
      m_PersistentCalls:
        m_Calls: []
    cutscenePostEvent:
      m_PersistentCalls:
        m_Calls: []
    autoNext: 1
  - name: 
    charactersData: []
    propsData: []
    nameString: 
    chatString: "Kh\xF4ng khen, kh\xF4ng m\u1EB7c c\u1EA3, ch\u1EC9 l\xE0 m\u1ED9t
      s\u1EF1 th\u1EEBa nh\u1EADn."
    cutscenePreEvent:
      m_PersistentCalls:
        m_Calls: []
    cutscenePostEvent:
      m_PersistentCalls:
        m_Calls: []
    autoNext: 1
  - name: 
    charactersData: []
    propsData: []
    nameString: 
    chatString: "S\u1ED1 ti\u1EC1n nh\u1EADn \u0111\u01B0\u1EE3c kh\xF4ng nhi\u1EC1u,
      \xEDt h\u01A1n c\u1EA3 nh\u1EEFng g\xEC ta c\u1EA7n, nh\u01B0ng \xEDt nh\u1EA5t
      ta \u0111\xE3 \u0111\u1ED5i \u0111\u01B0\u1EE3c th\xEAm n\u01B0\u1EDBc, th\xEAm
      h\u1EA1t gi\u1ED1ng, th\xEAm m\u1ED9t ng\xE0y\u2026 m\u1ED9t ng\xE0y cho con
      b\xE9."
    cutscenePreEvent:
      m_PersistentCalls:
        m_Calls: []
    cutscenePostEvent:
      m_PersistentCalls:
        m_Calls: []
    autoNext: 1
  - name: 
    charactersData: []
    propsData: []
    nameString: 
    chatString: "Nh\u01B0ng \u1EDF khu ch\u1EE3 \u0111en, c\xF3 nh\u1EEFng th\u1EE9
      kh\xE1c. Nh\u1EEFng lu\u1ED1ng c\xE2y ph\xE1t tri\u1EC3n nhanh h\u01A1n, xanh
      t\u1ED1t h\u01A1n, l\u1EDBn h\u01A1n m\u1ED9t c\xE1ch kh\xF4ng t\u1EF1 nhi\xEAn."
    cutscenePreEvent:
      m_PersistentCalls:
        m_Calls: []
    cutscenePostEvent:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 3801244044233279608}
          m_TargetAssemblyTypeName: UnityEngine.GameObject, UnityEngine
          m_MethodName: SetActive
          m_Mode: 6
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
        - m_Target: {fileID: 5329774293740533431}
          m_TargetAssemblyTypeName: UnityEngine.GameObject, UnityEngine
          m_MethodName: SetActive
          m_Mode: 6
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 1
          m_CallState: 2
    autoNext: 1
  - name: 
    charactersData: []
    propsData: []
    nameString: 
    chatString: "Ng\u01B0\u1EDDi ta kh\xF4ng ch\u1EDD \u0111\u1EE3i, kh\xF4ng hy
      v\u1ECDng. H\u1ECD d\xF9ng \u201Cth\u1EE9 \u0111\xF3\u201D."
    cutscenePreEvent:
      m_PersistentCalls:
        m_Calls: []
    cutscenePostEvent:
      m_PersistentCalls:
        m_Calls: []
    autoNext: 1
  - name: 
    charactersData: []
    propsData: []
    nameString: 
    chatString: "Ch\u1EC9 c\u1EA7n m\u1ED9t l\u1EA7n, \u0111\u1EA5t s\u1EBD cho l\u1EA1i
      t\u1EA5t c\u1EA3, kh\xF4ng c\u1EA7n th\u1EDDi gian, kh\xF4ng c\u1EA7n ki\xEAn
      nh\u1EABn, ch\u1EC9 c\u1EA7n\u2026 \u0111\xE1nh \u0111\u1ED5i."
    cutscenePreEvent:
      m_PersistentCalls:
        m_Calls: []
    cutscenePostEvent:
      m_PersistentCalls:
        m_Calls: []
    autoNext: 1
  - name: 
    charactersData: []
    propsData: []
    nameString: 
    chatString: "Barnaby kh\xF4ng nh\u1EAFc \u0111\u1EBFn n\xF3, \xF4ng l\xE3o tr\xE1nh
      nh\xECn v\xE0o nh\u1EEFng th\u1EE9 \u0111\xF3, nh\u01B0ng nh\u1EEFng k\u1EBB
      kh\xE1c th\xEC kh\xF4ng."
    cutscenePreEvent:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 5329774293740533431}
          m_TargetAssemblyTypeName: UnityEngine.GameObject, UnityEngine
          m_MethodName: SetActive
          m_Mode: 6
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
        - m_Target: {fileID: 1669251512516075051}
          m_TargetAssemblyTypeName: UnityEngine.GameObject, UnityEngine
          m_MethodName: SetActive
          m_Mode: 6
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 1
          m_CallState: 2
    cutscenePostEvent:
      m_PersistentCalls:
        m_Calls: []
    autoNext: 1
  - name: 
    charactersData: []
    propsData: []
    nameString: 
    chatString: "N\u1EBFu ti\u1EBFp t\u1EE5c nh\u01B0 th\u1EBF n\xE0y, ta s\u1EBD
      kh\xF4ng k\u1ECBp."
    cutscenePreEvent:
      m_PersistentCalls:
        m_Calls: []
    cutscenePostEvent:
      m_PersistentCalls:
        m_Calls: []
    autoNext: 1
  - name: 
    charactersData: []
    propsData: []
    nameString: 
    chatString: "M\xE0 th\u1EDDi gian\u2026 l\xE0 th\u1EE9 con b\xE9 kh\xF4ng c\xF2n
      nhi\u1EC1u."
    cutscenePreEvent:
      m_PersistentCalls:
        m_Calls: []
    cutscenePostEvent:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 5512458088648660267}
