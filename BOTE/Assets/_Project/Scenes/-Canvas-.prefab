  m_Name: 
  m_EditorClassIdentifier: 
  cutsceneData:
  - name: 
    charactersData: []
    propsData: []
    nameString: 
    chatString: "S\u1EF1 tr\u1EA3 th\xF9 c\u1EE7a thi\xEAn nhi\xEAn ch\u01B0a bao
      gi\u1EDD bu\xF4ng tha ch\xFAng t\xF4i.... C\u01A1n ho c\u1EE7a con b\xE9 ng\xE0y
      m\u1ED9t n\u1EB7ng h\u01A1n"
    cutscenePreEvent:
      m_PersistentCalls:
        m_Calls: []
    cutscenePostEvent:
      m_PersistentCalls:
        m_Calls: []
    autoNext: 1
  - name: 
    charactersData: []
    propsData: []
    nameString: 
    chatString: "L\xE3o th\u01B0\u01A1ng nh\xE2n Vance \u1EDF khu ch\u1EE3 \u0111en
      c\xF3 th\u1EE9 thu\u1ED1c xoa d\u1ECBu \u0111\u01B0\u1EE3c c\u01A1n \u0111au
      n\xE0y, nh\u01B0ng d\u01B0\u1EDBi \u0111\xE1y T\u1EA7ng Th\u1EA5p, ch\u1EB3ng
      c\xF3 \u0111\u1EB7c \xE2n n\xE0o l\xE0 mi\u1EC5n ph\xED"
    cutscenePreEvent:
      m_PersistentCalls:
        m_Calls: []
    cutscenePostEvent:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 7148402993202047790}
          m_TargetAssemblyTypeName: UnityEngine.GameObject, UnityEngine
          m_MethodName: SetActive
          m_Mode: 6
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
        - m_Target: {fileID: 2849382051225849390}
          m_TargetAssemblyTypeName: UnityEngine.GameObject, UnityEngine
          m_MethodName: SetActive
          m_Mode: 6
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
