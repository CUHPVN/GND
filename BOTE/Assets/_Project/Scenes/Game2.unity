      finalTransformID: 
      spriteString: TSB
    - name: Silas
      initialTransformID: 
      finalTransformID: 
      spriteString: Silas-Angry
    propsData: []
    nameString: Silas
    chatString: "Tao kh\xF4ng c\u1EA7n s\u1EF1 th\u01B0\u01A1ng h\u1EA1i c\u1EE7a
