    cutscenePostEvent:
      m_PersistentCalls:
        m_Calls: []
    autoNext: 1
  - name: 
    charactersData: []
    propsData: []
    nameString: 
    chatString: "Kh\xF4ng quy\u1EC1n l\u1EF1c, kh\xF4ng tri th\u1EE9c"
    cutscenePreEvent:
      m_PersistentCalls:
        m_Calls: []
    cutscenePostEvent:
      m_PersistentCalls:
        m_Calls: []
    autoNext: 1
  - name: 
    charactersData: []
    propsData: []
    nameString: 
    chatString: "Ch\u1EC9 c\xF3 \u0111\xF4i b\xE0n tay chai s\u1EA1n v\xE0 m\u1ED9t
      th\u1EE9 m\xE0 th\u1EBF gi\u1EDBi n\xE0y \u0111\xE3 \u0111\xE1nh m\u1EA5t t\u1EEB
      r\u1EA5t l\xE2u..."
    cutscenePreEvent:
      m_PersistentCalls:
        m_Calls: []
    cutscenePostEvent:
      m_PersistentCalls:
        m_Calls: []
    autoNext: 1
  - name: 
    charactersData: []
    propsData: []
    nameString: 
    chatString: "H\u1EB1ng ng\xE0y \xF4ng \u0111\xE0o x\u1EDBi m\u1EA3nh \u0111\u1EA5t
      kh\xF4 c\u1EB1n n\xE0y kh\xF4ng ph\u1EA3i v\xEC tin r\u1EB1ng n\xF3 s\u1EBD
