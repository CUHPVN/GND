    cutscenePreEvent:
      m_PersistentCalls:
        m_Calls: []
    cutscenePostEvent:
      m_PersistentCalls:
        m_Calls: []
    autoNext: 1
  - name: 
    charactersData: []
    propsData: []
    nameString: 
    chatString: "M\xE0 v\xEC \xF4ng tin r\u1EB1ng m\u1ED9t ng\xE0y n\xE0o \u0111\xF3
      n\xF3 c\xF3 th\u1EC3 h\u1ED3i sinh."
