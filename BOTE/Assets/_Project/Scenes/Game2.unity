  m_EditorClassIdentifier: 
  cutsceneData:
  - name: 
    charactersData: []
    propsData: []
    nameString: 
    chatString: "Ng\u01B0\u1EDDi ta n\xF3i\u2026 \u1EDF r\xECa khu ch\u1EE3 \u0111en\u2026"
    cutscenePreEvent:
      m_PersistentCalls:
        m_Calls: []
    cutscenePostEvent:
      m_PersistentCalls:
        m_Calls: []
    autoNext: 1
  - name: 
    charactersData: []
    propsData: []
    nameString: 
    chatString: "C\xF3 m\u1ED9t \xF4ng l\xE3o v\u1EABn c\xF2n gi\u1EEF nh\u1EEFng
      th\u1EE9 thu\u1ED9c v\u1EC1 \u201Cng\xE0y x\u01B0a\u201D."
    cutscenePreEvent:
      m_PersistentCalls:
        m_Calls: []
    cutscenePostEvent:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 1928746410}
          m_TargetAssemblyTypeName: UnityEngine.GameObject, UnityEngine
          m_MethodName: SetActive
          m_Mode: 6
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
        - m_Target: {fileID: 1784660527}
          m_TargetAssemblyTypeName: UnityEngine.GameObject, UnityEngine
          m_MethodName: SetActive
          m_Mode: 6
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 1
          m_CallState: 2
    autoNext: 1
  - name: 
    charactersData: []
    propsData: []
    nameString: 
    chatString: Barnaby.
    cutscenePreEvent:
      m_PersistentCalls:
        m_Calls: []
    cutscenePostEvent:
      m_PersistentCalls:
        m_Calls: []
    autoNext: 1
  - name: 
    charactersData: []
    propsData: []
    nameString: 
    chatString: "M\u1ED9t k\u1EBB l\u1EA1c l\xF5ng gi\u1EEFa th\u1EBF gi\u1EDBi \u0111\xE3
      m\u1EE5c ru\u1ED7ng n\xE0y."
    cutscenePreEvent:
      m_PersistentCalls:
        m_Calls: []
    cutscenePostEvent:
      m_PersistentCalls:
        m_Calls: []
    autoNext: 1
  - name: 
    charactersData: []
    propsData: []
    nameString: 
    chatString: "\xD4ng ta kh\xF4ng m\u1EB7c nh\u1EEFng b\u1ED9 \u0111\u1ED3 k\xEDn
      m\xEDt nh\u01B0 nh\u1EEFng k\u1EBB kh\xE1c.  Ch\u1EC9 l\xE0 m\u1ED9t chi\u1EBFc
      \xE1o kho\xE1c c\u0169\u2026 s\u1EDDn r\xE1ch theo n\u0103m th\xE1ng."
    cutscenePreEvent:
      m_PersistentCalls:
        m_Calls: []
    cutscenePostEvent:
      m_PersistentCalls:
        m_Calls: []
    autoNext: 1
  - name: 
    charactersData: []
    propsData: []
    nameString: 
    chatString: "B\xEAn c\u1EA1nh \xF4ng\u2026 lu\xF4n l\xE0 m\u1ED9t con l\u1EEBa
      gi\xE0, l\u1EB7ng l\u1EBD ch\u1EDF theo v\xE0i gi\u1ECF m\xE2y \u0111\u1EF1ng
      n\xF4ng s\u1EA3n s\u1EA1ch\u2026 v\xE0 nh\u1EEFng h\u1EA1t gi\u1ED1ng\u2026
      g\u1EA7n nh\u01B0 \u0111\xE3 bi\u1EBFn m\u1EA5t kh\u1ECFi n\u01A1i n\xE0y."
    cutscenePreEvent:
      m_PersistentCalls:
        m_Calls: []
    cutscenePostEvent:
      m_PersistentCalls:
        m_Calls: []
    autoNext: 1
  - name: 
    charactersData: []
    propsData: []
    nameString: 
    chatString: "N\u1EE5 c\u01B0\u1EDDi c\u1EE7a \xF4ng\u2026 l\xE0 th\u1EE9 hi\u1EBFm
      hoi c\xF2n s\xF3t l\u1EA1i gi\u1EEFa T\u1EA7ng Th\u1EA5p."
    cutscenePreEvent:
      m_PersistentCalls:
        m_Calls: []
    cutscenePostEvent:
      m_PersistentCalls:
        m_Calls: []
    autoNext: 1
  - name: 
    charactersData: []
    propsData: []
    nameString: 
    chatString: "Kh\xF4ng ph\u1EA3i ki\u1EC3u c\u01B0\u1EDDi \u0111\u1EC3 m\u1EB7c
      c\u1EA3\u2026m\xE0 l\xE0\u2026 m\u1ED9t th\u1EE9 g\xEC \u0111\xF3 r\u1EA5t
      c\u0169."
    cutscenePreEvent:
      m_PersistentCalls:
        m_Calls: []
    cutscenePostEvent:
      m_PersistentCalls:
        m_Calls: []
    autoNext: 1
  - name: 
    charactersData: []
    propsData: []
    nameString: 
    chatString: "\xD4ng ta thu mua nh\u1EEFng g\xEC m\xECnh tr\u1ED3ng \u0111\u01B0\u1EE3c.
      Gi\xE1 kh\xF4ng cao."
    cutscenePreEvent:
      m_PersistentCalls:
        m_Calls: []
    cutscenePostEvent:
      m_PersistentCalls:
        m_Calls: []
    autoNext: 1
  - name: 
    charactersData: []
    propsData: []
    nameString: 
    chatString: "Th\u1EADm ch\xED\u2026 \u0111\xF4i khi l\xE0 qu\xE1 th\u1EA5p."
    cutscenePreEvent:
      m_PersistentCalls:
        m_Calls: []
    cutscenePostEvent:
      m_PersistentCalls:
        m_Calls: []
    autoNext: 1
  - name: 
    charactersData: []
    propsData: []
    nameString: 
    chatString: "Nh\u01B0ng \u0111\u1ED5i l\u1EA1i\u2026"
    cutscenePreEvent:
      m_PersistentCalls:
        m_Calls: []
    cutscenePostEvent:
      m_PersistentCalls:
        m_Calls: []
    autoNext: 1
  - name: 
    charactersData: []
    propsData: []
    nameString: 
    chatString: "l\xE0 c\u1EA3m gi\xE1c r\u1EB1ng..."
    cutscenePreEvent:
      m_PersistentCalls:
        m_Calls: []
    cutscenePostEvent:
      m_PersistentCalls:
        m_Calls: []
    autoNext: 1
  - name: 
    charactersData: []
    propsData: []
    nameString: 
    chatString: "V\u1EABn c\xF2n \u0111i\u1EC1u g\xEC \u0111\xF3 ch\u01B0a ho\xE0n
      to\xE0n ch\u1EBFt \u0111i."
    cutscenePreEvent:
      m_PersistentCalls:
        m_Calls: []
    cutscenePostEvent:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 1784660527}
