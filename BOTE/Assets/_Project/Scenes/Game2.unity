    autoNext: 1
  - name: 
    charactersData: []
    propsData: []
    nameString: 
    chatString: "Nh\u01B0ng v\u1EABn c\xF2n nh\u1EEFng k\u1EBB kh\xF4ng khu\u1EA5t
      ph\u1EE5c tr\u01B0\u1EDBc s\u1ED1 ph\u1EADn."
