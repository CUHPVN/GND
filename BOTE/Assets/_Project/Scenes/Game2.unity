            m_StringArgument: 
            m_BoolArgument: 1
          m_CallState: 2
    autoNext: 1
  - name: 
    charactersData: []
    propsData: []
    nameString: 
    chatString: "N\u1EBFu nh\u1EEFng m\u1EA7m c\xE2y n\xE0y s\u1ED1ng s\xF3t\u2026
      ta s\u1EBD mang ch\xFAng \u0111\u1EBFn ch\u1ED7 \xF4ng \u1EA5y."
    cutscenePreEvent:
